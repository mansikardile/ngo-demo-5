// This is your Prisma schema file
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS  (contract Section 14)
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  COORDINATOR
}

enum ProgramStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  PARTICIPATED
  COMPLETED
}

enum VolunteerStatus {
  REGISTERED
  ASSIGNED
  ACTIVE
  COMPLETED
}

enum RegistrantType {
  PARTICIPANT
  VOLUNTEER
}

// ─────────────────────────────────────────────────────────────────────────────
// USER  — Admins / Staff / Coordinators only (contract Section 19)
// Supabase Auth manages passwords; we mirror identity here for RBAC
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  supabaseUid String   @unique @map("supabase_uid") // links to auth.users
  email       String   @unique
  name        String
  role        UserRole @default(STAFF)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  programs    Program[] @relation("ProgramCoordinator")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROGRAM  (use-case A, G)
// ─────────────────────────────────────────────────────────────────────────────

model Program {
  id            String        @id @default(uuid())
  programCode   String        @unique @map("program_code") // e.g. EDU-PUN-2026-01
  name          String
  description   String?
  category      String        // e.g. Education, Health, Skill Development
  location      String
  address       String?
  startDate     DateTime      @map("start_date")
  endDate       DateTime      @map("end_date")
  maxParticipants Int?        @map("max_participants")
  maxVolunteers   Int?        @map("max_volunteers")
  status        ProgramStatus @default(DRAFT)
  coordinatorId String?       @map("coordinator_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  coordinator   User?           @relation("ProgramCoordinator", fields: [coordinatorId], references: [id])
  registrations Registration[]
  impactRecords ImpactRecord[]

  @@index([status])
  @@index([location])
  @@index([programCode])
  @@map("programs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PARTICIPANT  (use-case J, K)
// Public registrants — NOT Supabase Auth users
// ─────────────────────────────────────────────────────────────────────────────

model Participant {
  id             String   @id @default(uuid())
  trackingId     String   @unique @map("tracking_id") // e.g. CPR-PAR-2EC3287E
  name           String
  email          String
  phone          String
  location       String
  college        String?  // College or Organization
  ageOrYear      String?  @map("age_or_year") // Age or Year of study
  areaOfInterest String?  @map("area_of_interest")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  registrations  Registration[]

  @@index([email])
  @@index([trackingId])
  @@map("participants")
}

// ─────────────────────────────────────────────────────────────────────────────
// VOLUNTEER  (use-case J, K, E)
// Public registrants — NOT Supabase Auth users
// ─────────────────────────────────────────────────────────────────────────────

model Volunteer {
  id             String   @id @default(uuid())
  trackingId     String   @unique @map("tracking_id") // e.g. CPR-VOL-3FA8219B
  name           String
  email          String
  phone          String
  location       String
  college        String?
  ageOrYear      String?  @map("age_or_year")
  areaOfInterest String?  @map("area_of_interest")
  totalHours     Float    @default(0) @map("total_hours") // accumulated contribution hours
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  registrations  Registration[]

  @@index([email])
  @@index([trackingId])
  @@map("volunteers")
}

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRATION  — links a Participant OR Volunteer to a Program (use-case D)
// One record per person per program
// ─────────────────────────────────────────────────────────────────────────────

model Registration {
  id              String             @id @default(uuid())
  programId       String             @map("program_id")
  participantId   String?            @map("participant_id")
  volunteerId     String?            @map("volunteer_id")
  registrantType  RegistrantType     @map("registrant_type")

  // Participation funnel status (use-case D)
  status          RegistrationStatus @default(REGISTERED)
  volunteerStatus VolunteerStatus?   @map("volunteer_status") // only for volunteers

  // Attendance & participation timestamps
  registeredAt    DateTime  @default(now()) @map("registered_at")
  attendedAt      DateTime? @map("attended_at")
  participatedAt  DateTime? @map("participated_at")
  completedAt     DateTime? @map("completed_at")

  // Volunteer-specific
  hoursContributed Float?   @map("hours_contributed")
  role             String?  // volunteer role in the program
  notes            String?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  program          Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  participant      Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  volunteer        Volunteer?   @relation(fields: [volunteerId], references: [id], onDelete: SetNull)

  @@unique([programId, participantId])
  @@unique([programId, volunteerId])
  @@index([programId])
  @@index([participantId])
  @@index([volunteerId])
  @@index([status])
  @@map("registrations")
}

// ─────────────────────────────────────────────────────────────────────────────
// IMPACT RECORD  — program-level outcome metrics (use-case F, U)
// ─────────────────────────────────────────────────────────────────────────────

model ImpactRecord {
  id                  String   @id @default(uuid())
  programId           String   @map("program_id")
  totalRegistered     Int      @default(0) @map("total_registered")
  totalAttended       Int      @default(0) @map("total_attended")
  totalParticipated   Int      @default(0) @map("total_participated")
  totalCompleted      Int      @default(0) @map("total_completed")
  totalVolunteers     Int      @default(0) @map("total_volunteers")
  totalVolunteerHours Float    @default(0) @map("total_volunteer_hours")
  attendanceRate      Float    @default(0) @map("attendance_rate")   // %
  completionRate      Float    @default(0) @map("completion_rate")   // %
  notes               String?
  recordedAt          DateTime @default(now()) @map("recorded_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  program             Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("impact_records")
}
